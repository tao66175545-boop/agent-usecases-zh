---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
---
<header class="site-header">
  <div class="container inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">Ag</span>
      <span>Agent用例导航</span>
    </a>
    <nav class="nav" aria-label="主导航">
      <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>用例</a>
      <a href="/subscribe" aria-current={currentPath === '/subscribe' ? 'page' : undefined}>订阅</a>
    </nav>
  </div>
</header>
